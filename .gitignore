bin/
# Shim workspace. The auto-seed walks up to the nearest .git, so
# running shims anywhere in this repo lands one at the root.
.nixgg/
example/.nixgg/
example/*.o
example/hello
.patched-nix
# Stray `nix build ... -o patch` output (a likely typo of -o
# .patched-nix seen recurring in this checkout) — not produced by any
# script here, but harmless local build output if it appears.
patch
patch-man
result*
